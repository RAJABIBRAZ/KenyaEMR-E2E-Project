{
  "name": "taifacare-e2e-optimization-project",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test:qa-performance": "playwright test --config=playwright.qa.config.ts",
    "test:qa-performance:list": "playwright test --config=playwright.qa.config.ts --list",
    "test:uat-performance": "playwright test --config=playwright.uat.config.ts",
    "test:uat-performance:long": "playwright test --config=playwright.uat-long.config.ts",
    "test:qa-smoke": "playwright test --config=playwright.qa-smoke.config.ts",
    "test:qa-smoke:list": "playwright test --config=playwright.qa-smoke.config.ts --list",
    "test:uat-registration": "playwright test --config=playwright.registration-uat.config.ts",
    "test:uat-registration:list": "playwright test --config=playwright.registration-uat.config.ts --list",
    "test:uat-registration:unit": "node --experimental-strip-types tests/registration-identity.test.mjs",
    "test:uat-registration-readonly": "playwright test --config=playwright.registration-readonly.config.ts",
    "test:uat-registration-readonly:list": "playwright test --config=playwright.registration-readonly.config.ts --list",
    "test:uat-principal-otp": "playwright test --config=playwright.registration-principal-otp.config.ts",
    "test:uat-principal-otp:list": "playwright test --config=playwright.registration-principal-otp.config.ts --list",
    "registration:matrix": "python3 tools/generate-registration-workflow-readiness.py",
    "tracker:run-id": "python3 tools/uat_patient_tracker.py new-run-id",
    "tracker:export": "python3 tools/uat_patient_tracker.py export",
    "tracker:test": "python3 -m unittest discover -s tests -v"
  },
  "devDependencies": {
    "@playwright/test": "1.50.1"
  }
}
